# Server only. Legacy internal DB/private Storage; never expose this credential.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# TASK-056 optional Auth foundation. Public URL and public publishable key ONLY.
# Set both for Auth; absent together preserves the legacy internal workflow.
# Use a real sb_publishable_ key from the SAME Supabase project. JWT/secret keys
# are rejected; legacy anon JWT is not accepted by this first Auth adapter.
# Next inlines these at build time. Never put a privileged key in NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required when running AI features; automatic tests use mocks.
OPENAI_API_KEY=
# Optional model overrides. Defaults below are the current code defaults.
# Asset analysis: gpt-5.6-luna
OPENAI_ASSET_MODEL=
# Product analysis: gpt-5.6-terra
OPENAI_PRODUCT_MODEL=

# Fact Validation model override (server only; default gpt-5.6-terra)
OPENAI_VALIDATION_MODEL=

# Page Planner model override (server only; default gpt-5.6-terra)
OPENAI_PLANNER_MODEL=

# Section Engine model override (default: gpt-5.6-terra)
OPENAI_SECTION_MODEL=
OPENAI_SECTION_REGEN_MODEL=

# Trusted capture origin. Dev default: http://127.0.0.1:3000.
# Required with npm start, even locally, and by new Auth mutation primitives.
# Must match the running app origin/port.
# Never inferred from Host; no pathname, query, credentials or hash.
DETAILFORGE_APP_ORIGIN=
# Optional Playwright browser cache directory (same value at install and runtime).
PLAYWRIGHT_BROWSERS_PATH=

# Required only for official Domeggook option import/diagnostics (server only).
# Missing key returns a feature-level configuration error.
DOMEGGOOK_API_KEY=

# TASK-024 server-only tile Vision model (default gpt-5.6-luna)
OPENAI_DETAIL_EXTRACTION_MODEL=
